{
  "name": "image-tagger",
  "private": true,
  "version": "0.2.2",
  "description": "Everything-fast local image search with AI auto-tagging. 100% local.",
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=10"
  },
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "setup": "node scripts/setup_node.js && npm run setup:py",
    "setup:renderer": "npm install --prefix apps/desktop/renderer",
    "setup:py": "python scripts/setup_dev.py",
    "bench": "python scripts/bench_search.py",
    "build:renderer": "npm run build --prefix apps/desktop/renderer",
    "prepare:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-python-runtime.ps1",
    "start": "npm run dev",
    "app": "npm run dev --workspace @image-tagger/desktop",
    "dev": "npm run build:renderer && npm run dev --workspace @image-tagger/desktop",
    "dist": "npm run build:renderer && npm run prepare:runtime && npm run dist --workspace @image-tagger/desktop && npm run verify:package",
    "dist:win": "npm run dist",
    "verify:package": "python scripts/verify_packaged_daemon.py",
    "test:python": "python scripts/run_python_tests.py",
    "test:electron": "npm run test:smoke --workspace @image-tagger/desktop",
    "test:ui": "npm run test:ui --workspace @image-tagger/desktop",
    "test": "npm run build:renderer && npm run test:python && npm run test:electron",
    "dev:indexer": "python scripts/run_indexer.py"
  },
  "license": "MIT"
}
